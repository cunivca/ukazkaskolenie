<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Creating a tree view and menu item for contract.number model -->
        <record id="view_contract_number_tree" model="ir.ui.view">
            <field name="name">origamis.contract.number.tree</field>
            <field name="model">contract.number</field>
            <field name="arch" type="xml">
                <tree editable="top" create="1" delete="1" multi_edit="1">
                    <field name="sale_order_id" readonly="0" optional="show"/>
                    <field name="customer_id" readonly="0" optional="show"/>
                    <field name="name" required="True"/>
                    <field name="framework_contract_no" required="True"/>
                    <field name="description"/>
                    <field name="upload_contract"/>
                </tree>
            </field>
        </record>

        <record id="action_contract_number" model="ir.actions.act_window">
            <field name="res_model">contract.number</field>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_contract_number_tree"/>
        </record>

        <menuitem id="menu_contract_number"
                  name="Contracts"
                  parent="sale.sale_order_menu"
                  action="action_contract_number"
                  sequence="15"
        />
    </data>
</odoo>
