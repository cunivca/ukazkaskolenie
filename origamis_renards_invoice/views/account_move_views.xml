<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Adding additional_text field to the account.move form view -->
        <record id="view_move_form_inherit_origamis" model="ir.ui.view">
            <field name="name">account.move.form.inherit.origamis</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form" />
            <field name="mode">extension</field>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='sale_info_group']//field[@name='delivery_date']" position="after">
                    <field name="additional_text" invisible="move_type != 'out_invoice'"/>
                    <field name="date_of_signature" invisible="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
 