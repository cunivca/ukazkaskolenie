<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Adding logo_2 field to the base.document.layout wizard form view -->
        <record id="view_base_document_layout_inherit_origamis" model="ir.ui.view">
            <field name="name">Document Layout.inherit.origamis</field>
            <field name="model">base.document.layout</field>
            <field name="inherit_id" ref="web.view_base_document_layout" />
            <field name="mode">extension</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='layout_background']" position="before">
                     <field name="logo_2" widget="image" options="{'size': [0, 50]}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
 